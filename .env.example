# Supabase プロジェクトの Settings > API から取得して .env.local にコピーしてください。
# 未設定の場合は、記録をこの端末にだけ保存する「デモモード」で起動します。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase を設定すると、観測者ID（ML-XXXX-XXXX）で端末の記録をクラウドに同期します
# （supabase/migrations/20261031000000_observer_saves.sql を実行しておくこと）。
# 従来のメール認証＋DB の勉強記録で動かす場合だけ email を指定します。
NEXT_PUBLIC_AUTH_MODE=
