# Supabase プロジェクトの Settings > API から取得して .env.local にコピーしてください。
# 未設定の場合は、記録をこの端末にだけ保存する「デモモード」で起動します。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase を設定すると、端末の記録をクラウドに同期します。
# - ログインしていなければ観測者ID（ML-XXXX-XXXX）で預ける（supabase/migrations/20261031000000_observer_saves.sql）
#   総当たり対策として、外れた試行を IP ごとに1時間5回までに制限する（20261102000000_observer_rate_limit.sql）
#   記録を開くには観測者IDに加えて復元キーが要る（20261103000000_observer_recovery_key.sql）
# - Google でログインすればアカウントに預ける（supabase/migrations/20261101000000_account_saves.sql）
#   Supabase の Authentication > Sign In / Providers で Google を有効にし、
#   Authentication > URL Configuration の Redirect URLs に <サイトのURL>/auth/callback を加えておくこと。
# 従来のメール認証＋DB の勉強記録で動かす場合だけ email を指定します。
NEXT_PUBLIC_AUTH_MODE=
